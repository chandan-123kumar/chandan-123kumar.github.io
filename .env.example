# Copy to .env locally. In Vercel, add these as environment variables, then redeploy.
APP_ORIGIN=http://127.0.0.1:3047
PORT=3047
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=chandan
ADMIN_PASSWORD=replace-with-a-long-admin-password
ADMIN_NAME=Chandan Kumar
STUDENT_USERNAME=student
STUDENT_PASSWORD=replace-with-a-long-student-password
STUDENT_NAME=Student
# Optional additional students. Usernames must be unique, lowercase, 3–40 characters.
# STUDENTS_JSON='[{"username":"aarav","password":"choose-a-long-password","name":"Aarav"}]'
COURSE_PUBLISHED=true
