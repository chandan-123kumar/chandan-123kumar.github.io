    "pretest": "node scripts/build-sanitizer.js",
    "predev": "node scripts/build-sanitizer.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "marked": "^15.0.12",
    "mongodb": "^6.21.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
