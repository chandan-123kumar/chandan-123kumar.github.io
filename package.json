{
  "name": "chandan-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/learn-dev.js",
    "build": "node scripts/build-site.js",
    "test": "node --test tests/learn/*.test.js",
    "db:setup": "node --env-file-if-exists=.env scripts/learn-mongo-setup.js",
